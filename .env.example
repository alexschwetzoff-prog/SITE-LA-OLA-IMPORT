# Variables de entorno. Copia este archivo a .env.local (git lo ignora) y pon ahí los valores reales.
# En Netlify: Site configuration → Environment variables → Add a variable (las mismas; ver docs/LANZAMIENTO.md).
# Cualquier cambio en Netlify necesita un despliegue nuevo (Deploys → Trigger deploy) para aplicarse.

# WhatsApp en formato internacional sin "+". [WHATSAPP] pendiente.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ---------------------------------------------------------------------------------------------------------------
# Correo del formulario «Cuéntanos tu proyecto» (fase 6 y fase 9). Sin base de datos: cada solicitud llega por email.
# ---------------------------------------------------------------------------------------------------------------

# Transporte: "gmail" (SMTP de Gmail con contraseña de aplicación), "resend" (API de Resend desde el dominio propio;
# si Resend falla, respaldo automático por Gmail) o "archivo" (pruebas: cada email se guarda como carpeta en
# .correo-local/, que git ignora). Si no se indica: resend cuando hay RESEND_API_KEY; si no, gmail cuando hay
# contraseña; en local sin nada, archivo. En producción sin ningún transporte configurado no se envía nada y el
# formulario enseña el error con el botón de WhatsApp.
CORREO_TRANSPORTE=gmail

# Cuenta de Gmail que envía (con el transporte gmail) y recibe los emails.
GMAIL_USUARIO=
# Contraseña de aplicación de Google de esa cuenta (16 letras; con o sin espacios). SOLO aquí y en Netlify, nunca en el
# código ni en la documentación. Se crea en myaccount.google.com → Seguridad → Verificación en dos pasos → Contraseñas de aplicación.
GMAIL_CONTRASENA_APP=
# Buzón al que llegan las solicitudes (si se deja vacío, el mismo GMAIL_USUARIO).
CORREO_DESTINO=

# Resend (fase 9): listo pero apagado hasta que el dominio esté verificado en Resend. Para activarlo, sin tocar código:
# CORREO_TRANSPORTE=resend y la clave de la API (empieza por "re_"). Remitente por defecto: [MARCA] <hola@dominio-pendiente.example>
# (solo envío; las respuestas van a CORREO_DESTINO por el reply-to). Se puede cambiar con RESEND_REMITENTE.
RESEND_API_KEY=
# RESEND_REMITENTE=[MARCA] <hola@dominio-pendiente.example>

# Opiniones de clientes (fase 10): dirección del CSV publicado de la pestaña «Web» de la hoja de respuestas del
# formulario de opinión (en Google Sheets: Archivo → Compartir → Publicar en la web → esa pestaña, formato CSV).
# Solo del servidor (nunca NEXT_PUBLIC_): la lee lib/opiniones/obtener.ts cada hora (ISR). Sin ella, la web no
# enseña opiniones y no falla. El valor real va en .env.local (que git ignora) y en Netlify, nunca aquí ni en el código.
OPINIONES_CSV_URL=

# Indexación (fase 9). Normalmente no hace falta: la web se indexa solo en el despliegue de producción de
# dominio-pendiente.example (lo detecta por las variables de Netlify o Vercel) y lleva noindex en vistas previas y en
# *.netlify.app / *.vercel.app. INDEXAR=1 o INDEXAR=0 lo fuerza.
# INDEXAR=

# Sin uso en la v1: no hay base de datos. Se quedan como recordatorio para cuando entre.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
